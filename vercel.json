{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/thanks",
      "destination": "/merci",
      "permanent": true
    },
    {
      "source": "/thanks.html",
      "destination": "/merci",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
